@model FriendsTown.Web.Models.SelectFriendViewModel
<h4>Select your name</h4>
<br />
<div class="row">
<div class="col-md-4">
   <form asp-action="ProcessSelectFriend">
            <div class="form-group">
                <label class="control-label">Name</label>
                <select asp-for="SelectedFriend" 
                    asp-items="Model.FriendNames"></select>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Select" 
                    class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
